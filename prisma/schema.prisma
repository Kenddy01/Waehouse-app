datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id      Int     @id @default(autoincrement())
  code    String  @unique
  product String
  ti      Int
  hi      Int
  truck   String?
  tie     Int?
  height  Int?
  vendor  String
}
